{
  "name": "a2ui-composer-shell",
  "version": "0.1.0",
  "private": true,
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "type": "module",
  "scripts": {
    "start": "yarn workspace ng-basic-catalog build && yarn workspace lit-basic-catalog build && yarn workspace react-basic-catalog build && ng serve",
    "build": "yarn lint && yarn workspace ng-basic-catalog build && yarn workspace lit-basic-catalog build && yarn workspace react-basic-catalog build && ng build",
    "test": "ng test --no-watch --coverage",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots=all",
    "e2e": "playwright test --project=e2e",
    "e2e-headless": "E2E_HEADLESS=true playwright test --project=e2e",
    "prettier": "prettier --ignore-path ../.prettierignore --write . | grep -v '(unchanged)'",
    "prettier:check": "prettier --ignore-path ../.prettierignore --check .",
    "clean": "rm -rf dist .angular coverage",
    "lint": "eslint ."
  },
  "dependencies": {
    "@angular/cdk": "22.2.4",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/material": "22.2.4",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@copilotkit/angular": "0.5.2",
    "@google/genai": "2.11.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@monaco-editor/loader": "1.7.0",
    "a2ui-bridge": "0.1.0",
    "dockview-core": "7.0.3",
    "dompurify": "3.4.16",
    "marked": "18.0.11",
    "monaco-editor": "0.56.0",
    "rxjs": "7.8.2",
    "safevalues": "1.2.0",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.3",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.61.1",
    "@types/dompurify": "3.2.0",
    "@types/jsdom": "28.0.3",
    "@vitest/coverage-v8": "4.1.11",
    "angular-eslint": "22.6.0",
    "eslint": "10.7.0",
    "jsdom": "29.1.1",
    "lit-basic-catalog": "0.1.0",
    "ng-basic-catalog": "0.1.0",
    "prettier": "3.9.6",
    "react-basic-catalog": "0.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.11"
  }
}
