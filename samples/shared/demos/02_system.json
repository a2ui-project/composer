{
  "name": "System dashboard",
  "description": "A sample health snapshot with CPU, memory, and storage usage.",
  "messages": [
    {
      "version": "1.0",
      "createSurface": {
        "surfaceId": "showcase-02-system",
        "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
        "sendDataModel": true,
        "components": [
          {
            "id": "root",
            "component": "Card",
            "child": "content"
          },
          {
            "id": "content",
            "component": "Column",
            "children": ["header", "metrics", "divider", "storage"]
          },
          {
            "id": "header",
            "component": "Row",
            "children": ["title", "status"],
            "justify": "spaceBetween",
            "align": "center"
          },
          {
            "id": "title",
            "component": "Text",
            "text": "### System status"
          },
          {
            "id": "status",
            "component": "Text",
            "text": "All systems healthy",
            "variant": "caption"
          },
          {
            "id": "metrics",
            "component": "Row",
            "children": ["cpu", "memory"],
            "justify": "spaceAround",
            "align": "center"
          },
          {
            "id": "cpu",
            "component": "Column",
            "children": ["cpu_label", "cpu_gauge"],
            "align": "center"
          },
          {
            "id": "cpu_label",
            "component": "Text",
            "text": "CPU load",
            "variant": "caption"
          },
          {
            "id": "cpu_gauge",
            "component": "Image",
            "url": {
              "@path": "/cpuChart"
            },
            "description": "CPU load: 65 percent",
            "variant": "smallFeature",
            "fit": "contain"
          },
          {
            "id": "memory",
            "component": "Column",
            "children": ["memory_label", "memory_gauge"],
            "align": "center"
          },
          {
            "id": "memory_label",
            "component": "Text",
            "text": "Memory",
            "variant": "caption"
          },
          {
            "id": "memory_gauge",
            "component": "Image",
            "url": {
              "@path": "/memoryChart"
            },
            "description": "Memory usage: 82 percent",
            "variant": "smallFeature",
            "fit": "contain"
          },
          {
            "id": "divider",
            "component": "Divider"
          },
          {
            "id": "storage",
            "component": "Row",
            "children": ["storage_label", "storage_value"],
            "justify": "spaceBetween"
          },
          {
            "id": "storage_label",
            "component": "Text",
            "text": "Storage used",
            "variant": "caption"
          },
          {
            "id": "storage_value",
            "component": "Text",
            "text": "78% · 156 GB of 200 GB",
            "variant": "body"
          }
        ],
        "dataModel": {
          "cpuChart": "data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22120%22%20height%3D%22120%22%20viewBox%3D%220%200%20120%20120%22%3E%3Cstyle%3Esvg%7Bcolor-scheme%3Alight%20dark%7Dtext%7Bfill%3Alight-dark%28%23202124%2C%23eef0f3%29%3Bfont%3A500%2024px%20Arial%2Csans-serif%7D%3C%2Fstyle%3E%3Ccircle%20cx%3D%2260%22%20cy%3D%2260%22%20r%3D%2248%22%20fill%3D%22none%22%20stroke%3D%22%233f51b5%22%20stroke-opacity%3D%22.2%22%20stroke-width%3D%229%22%2F%3E%3Ccircle%20cx%3D%2260%22%20cy%3D%2260%22%20r%3D%2248%22%20fill%3D%22none%22%20stroke%3D%22%235a86f7%22%20stroke-width%3D%229%22%20stroke-linecap%3D%22round%22%20pathLength%3D%22100%22%20stroke-dasharray%3D%2265%20100%22%20transform%3D%22rotate%28-90%2060%2060%29%22%2F%3E%3Ctext%20x%3D%2260%22%20y%3D%2268%22%20text-anchor%3D%22middle%22%3E65%25%3C%2Ftext%3E%3C%2Fsvg%3E",
          "memoryChart": "data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22120%22%20height%3D%22120%22%20viewBox%3D%220%200%20120%20120%22%3E%3Cstyle%3Esvg%7Bcolor-scheme%3Alight%20dark%7Dtext%7Bfill%3Alight-dark%28%23202124%2C%23eef0f3%29%3Bfont%3A500%2024px%20Arial%2Csans-serif%7D%3C%2Fstyle%3E%3Ccircle%20cx%3D%2260%22%20cy%3D%2260%22%20r%3D%2248%22%20fill%3D%22none%22%20stroke%3D%22%233f51b5%22%20stroke-opacity%3D%22.2%22%20stroke-width%3D%229%22%2F%3E%3Ccircle%20cx%3D%2260%22%20cy%3D%2260%22%20r%3D%2248%22%20fill%3D%22none%22%20stroke%3D%22%235a86f7%22%20stroke-width%3D%229%22%20stroke-linecap%3D%22round%22%20pathLength%3D%22100%22%20stroke-dasharray%3D%2282%20100%22%20transform%3D%22rotate%28-90%2060%2060%29%22%2F%3E%3Ctext%20x%3D%2260%22%20y%3D%2268%22%20text-anchor%3D%22middle%22%3E82%25%3C%2Ftext%3E%3C%2Fsvg%3E"
        }
      }
    }
  ]
}
