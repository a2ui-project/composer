[
  {
    "version": "v0.9",
    "createSurface": {
      "surfaceId": "match-report",
      "catalogId": "https://a2ui-project.github.io/composer/catalogs/slack/v1"
    }
  },
  {
    "version": "v0.9",
    "updateComponents": {
