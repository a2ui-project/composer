          "data": [
            {"label": "Argentina", "value": 70},
            {"label": "Mexico", "value": 30}
          ]
        },
        {
          "id": "share",
          "component": "Button",
          "child": "share-label",
          "action": {"event": {"name": "share_result"}}
        },
        {
          "id": "share-label",
          "component": "Text",
          "text": "Share result"
        }
      ]
    }
